{
  "name": "moderado",
  "version": "0.3.4",
  "description": "A lightweight, provider-independent CLI coding agent with free-first model routing.",
  "type": "module",
  "bin": {
    "moderado": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=20" },
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/marcuz-apl/moderado.git" },
  "bugs": { "url": "https://github.com/marcuz-apl/moderado/issues" },
  "homepage": "https://github.com/marcuz-apl/moderado#readme",
  "keywords": ["ai", "agent", "coding-agent", "cli", "nvidia-nim", "openrouter"],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node ./dist/index.js",
    "test": "vitest run",
    "prepack": "npm --prefix ../.. run build && npm --prefix ../.. run prepare:package"
  },
  "dependencies": {
    "zod": "^3.24.2"
  }
}
