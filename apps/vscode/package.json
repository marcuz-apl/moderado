{
  "name": "moderado-vscode",
  "displayName": "Moderado",
  "description": "Moderated AI coding assistant sidecar for VS Code",
  "version": "0.4.0",
  "publisher": "marcuz-apl",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Programming Languages"
  ],
  "activationEvents": [
    "onView:moderado.chatView",
    "onCommand:moderado.focusChat",
    "onCommand:moderado.newSession",
    "onCommand:moderado.resumeSession",
    "onCommand:moderado.cancelTurn"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "moderado-sidebar",
          "title": "Moderado",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "moderado-sidebar": [
        {
          "type": "webview",
          "id": "moderado.chatView",
          "name": "Moderado Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "moderado.focusChat",
        "title": "Moderado: Focus Chat"
      },
      {
        "command": "moderado.newSession",
        "title": "Moderado: New Session"
      },
      {
        "command": "moderado.resumeSession",
        "title": "Moderado: Resume Session"
      },
      {
        "command": "moderado.cancelTurn",
        "title": "Moderado: Cancel Turn"
      },
      {
        "command": "moderado.selectProvider",
        "title": "Moderado: Select Provider"
      },
      {
        "command": "moderado.selectModel",
        "title": "Moderado: Select Model"
      }
    ],
    "configuration": {
      "title": "Moderado",
      "properties": {
        "moderado.executablePath": {
          "type": "string",
          "default": "",
          "description": "Path to the moderado executable. Defaults to resolving 'moderado' from the system PATH."
        },
        "moderado.provider": {
          "type": "string",
          "default": "",
          "description": "Provider connection ID to use (e.g. 'nvidia-nim', 'openrouter', 'agnes', 'orcarouter'). If empty, uses the active connection from Moderado CLI."
        },
        "moderado.model": {
          "type": "string",
          "default": "",
          "description": "Specific model ID to pin for coding tasks (e.g. 'z-ai/glm-5.3-flash', 'qwen/qwen3.8-27b:free'). If empty, uses free-first auto-routing."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc && node ./scripts/build_extension.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "node ./scripts/package_vsix.mjs"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0"
  }
}
