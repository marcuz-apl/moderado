{
  "name": "moderado-root",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "moderado": "node apps/cli/dist/index.js",
    "prepare:package": "node scripts/prepare_npm_package.mjs",
    "verify:package": "npm run build && npm run prepare:package && node scripts/verify_npm_package.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
