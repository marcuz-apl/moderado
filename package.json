{
  "name": "moderado-root",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "moderado": "node apps/cli/dist/index.js",
    "prepare:package": "node scripts/prepare_npm_package.mjs",
    "verify:package": "npm run build && npm run prepare:package && node scripts/verify_npm_package.mjs",
    "build:binaries": "npm run build && node scripts/binaries.mjs build",
    "verify:binaries": "node scripts/binaries.mjs verify",
    "merge-binaries": "node scripts/binaries.mjs merge",
    "generate:manifests": "node scripts/distribution_manifests.mjs",
    "build:vscode": "tsc -b && tsc --project apps/vscode/tsconfig.json && node apps/vscode/scripts/build_extension.mjs && node apps/vscode/scripts/verify_sidecar_build.mjs",
    "test:vscode": "vitest run apps/vscode/tests",
    "typecheck:vscode": "tsc --project apps/vscode/tsconfig.json --noEmit",
    "package:vscode": "npm --prefix apps/vscode run package"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@yao-pkg/pkg": "^6.22.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
