#!/bin/sh
HOOKDIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$HOOKDIR/versionlib.sh"

msgfile=$1
[ -f "$msgfile" ] || die "commit message file is missing"
pending=$(git rev-parse --git-path ALFAZEN_PENDING) || exit 1
rm -f -- "$pending" || exit 1
old=$(read_version)
validate_identifier "$old"
message=$(sed -E '1s/^v[0-9]+[.][0-9]+[.][0-9]+[+-][0-9]{6}[0-9a-zA-Z] //' "$msgfile") || exit 1
bump=$(detect_bump_type "$message")
[ "$bump" != major_requires_approval ] || die "Major version bump detected; explicit user approval is required"
new=$(next_identifier "$old" "$(utc_yymmdd)" "$bump") || exit 1
validate_identifier "$new"

tmp=$(mktemp) || exit 1
awk -v stamp="$new" '!done && $0 !~ /^#/ { sub(/^v[0-9]+[.][0-9]+[.][0-9]+[+-][0-9][0-9][0-9][0-9][0-9][0-9a-zA-Z] /, ""); print stamp " " $0; done=1; next } { print }' "$msgfile" > "$tmp" && mv -f -- "$tmp" "$msgfile" || exit 1
previous=$(git rev-parse --verify HEAD 2>/dev/null || true)
printf '%s\n%s\n' "$previous" "$new" > "$pending" || exit 1
