#!/bin/sh
set -eu
HOOKDIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$HOOKDIR/versionlib.sh"

# Git creates COMMIT_EDITMSG only *after* pre-commit runs, so this hook can
# never classify the message it is committing. It therefore advances only the
# UTC build counter and preserves the SemVer it finds. A SemVer change is
# explicit: `npm run version:patch|minor` stages VERSION, apps/cli/package.json
# and package-lock.json before the release commit. `commit-msg` then rejects a
# `release(...)` subject whose SemVer did not actually change.
old=$(read_version)
validate_identifier "$old"
new=$(next_identifier "$old" "$(utc_yymmdd)" build) || exit 1
printf '%s\n' "$new" > "$VERSION_FILE"
git add -- "$VERSION_FILE"
