#!/bin/sh
HOOKDIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$HOOKDIR/versionlib.sh"

msgfile="$(git rev-parse --git-path COMMIT_EDITMSG)"
[ -f "$msgfile" ] || die "commit message file is missing"
old=$(read_version)
validate_identifier "$old"
# COMMIT_EDITMSG can still hold the *previous* commit's already-stamped message,
# so strip every leading version stamp before classifying the bump type. Without
# this, `release(patch):` commits were misread as plain build bumps and SemVer was
# never advanced.
message=$(sed -E 's/^(v[0-9]+\.[0-9]+\.[0-9]+[+-][0-9]{6}[0-9a-zA-Z] )+//' "$msgfile" 2>/dev/null || true)
new=$(next_identifier "$old" "$(utc_yymmdd)" "$(detect_bump_type "$message")") || exit 1
printf '%s\n' "$new" > "$VERSION_FILE"
git add -- "$VERSION_FILE"

tmp=$(mktemp) || exit 1
awk -v stamp="$new" '!done && $0 !~ /^#/ { sub(/^v[0-9]+\.[0-9]+\.[0-9]+[+-][0-9][0-9][0-9][0-9][0-9][0-9][0-9a-zA-Z] /, ""); print stamp " " $0; done=1; next } { print }' "$msgfile" > "$tmp" && mv -f -- "$tmp" "$msgfile"